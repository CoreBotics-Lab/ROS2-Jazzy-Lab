{
    // --- Python & Pyrefly ---
    "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
    "python.languageServer": "Default",
    "python.pyrefly.typeCheckingMode": "default",
    "python.pyrefly.disableTypeErrors": false,
    "python.REPL.enableREPLSmartSend": false,
    "python.analysis.diagnosticsSource": "Pylance + Pyrefly",
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/install/**/lib/python3.12/site-packages",
        "${workspaceFolder}/.pixi/envs/default/lib/python3.12/site-packages",
        "${workspaceFolder}/src/MCU_ROS2_integration_workbench/shared_libraries/python"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/install/**/lib/python3.12/site-packages",
        "${workspaceFolder}/.pixi/envs/default/lib/python3.12/site-packages",
        "${workspaceFolder}/src/MCU_ROS2_integration_workbench/shared_libraries/python"
    ],

    // --- Pixi Code Extension ---
    "pixi-code.pixiExecutable": "~/.pixi/bin/pixi",

    // --- C++ & Clangd ---
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--header-insertion=never",
        "--all-scopes-completion",
        "--completion-style=detailed"
    ],

    // --- ROS 2 Specifics ---
    "ros.distro": "jazzy",
    "ros.rosSetupScript": "${workspaceFolder}/.pixi/envs/default/setup.bash",
    "cmake.ignoreCMakeListsMissing": true,

    // --- URDF Visualizer Extension ---
    "urdf-visualizer.packages": {
        "core_description": "${workspaceFolder}/src/gazebo_sim/gazebo_core/core_description",
        "bumperbot_description": "${workspaceFolder}/src/Odometry_and_Control/bumperbot_description"
    },
    "urdf-visualizer.default.showLinkFrames": true,
    "urdf-visualizer.default.linkFrameSize": 0.5,
    "urdf-visualizer.highlightLinkWhenHover": true,
    "urdf-visualizer.showTips": false,

    // --- Performance & Exclusions (Keeps VS Code snappy) ---
    "git.autofetch": false,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.pixi/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true,
        "**/_legacy_build/**": true,
        "**/_legacy_install/**": true,
        "**/_legacy_log/**": true,
        "**/__pycache__/**": true,
        "**/pixi.lock": true
    },
    "files.exclude": {
        "**/.pixi": true,
        "**/bash_scripts": true,
        "**/pixi.lock": true,
        "**/.gitattributes": true,
        "**/build": true,
        "**/install": true,
        "**/log": true,
        "**/_legacy_build": true,
        "**/_legacy_install": true,
        "**/_legacy_log": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "**/.pixi": true,
        "**/bash_scripts": true,
        "**/pixi.lock": true,
        "**/build": true,
        "**/install": true,
        "**/log": true,
        "**/_legacy_build": true,
        "**/_legacy_install": true,
        "**/_legacy_log": true
    }
}

