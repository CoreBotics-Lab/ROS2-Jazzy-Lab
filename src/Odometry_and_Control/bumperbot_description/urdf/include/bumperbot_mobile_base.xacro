  <!-- Link caster_front_link -->
  <link name="caster_front_link">
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    <!-- Part caster_ball -->
    <visual>
      <origin xyz="0 0 -0" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/caster_ball.stl"/>
      </geometry>
      <material name="caster_ball_material">
        <color rgba="0.917647 0.917647 0.917647 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/caster_ball.stl"/>
      </geometry>
    </collision>
    <!-- Part caster_frame -->
    <visual>
      <origin xyz="0 0 0" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/caster_frame.stl"/>
      </geometry>
      <material name="caster_frame_material">
        <color rgba="0.262745 0.282353 0.301961 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/caster_frame.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint from base_link to caster_front_link -->
  <joint name="caster_front_joint" type="fixed">
    <origin xyz="0.0480264 -0 ${caster_z_offset}" rpy="0 -0 0"/> 
    <parent link="base_link"/>
    <child link="caster_front_link"/>
  </joint>
  <!-- Link caster_rear_link -->
  <link name="caster_rear_link">
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    <!-- Part caster_ball_2 -->
    <visual>
