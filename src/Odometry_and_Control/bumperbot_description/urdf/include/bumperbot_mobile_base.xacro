<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="caster_z_offset" value="-0.005237682" />
<!-- -0.005237682 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_footprint_to_base_link_z}"/>
  </joint>
  
<!-- Link base_link -->
  <link name="base_link">
