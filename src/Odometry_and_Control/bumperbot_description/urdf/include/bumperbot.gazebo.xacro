<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Controller config YAML injected at launch time via the controller_config xacro arg.
       Default: bumperbot_ros2_control.yaml (production ros2_control path).
       Override from the launch file to select a different controller set, e.g.:
         xacro bumperbot.urdf.xacro controller_config:=/path/to/bumperbot_controllers.yaml -->
  <xacro:arg name="controller_config"
             default="$(find bumperbot_controllers)/config/bumperbot_ros2_control.yaml"/>

  <gazebo reference="wheel_right_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="wheel_left_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="caster_front_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="caster_rear_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_config)</parameters>
      <!-- <ros>
        <remapping>/bumperbot_controller/cmd_vel:=/cmd_vel</remapping>
        <remapping>/bumperbot_controller/cmd_vel_out:=/cmd_vel_out</remapping>
        <remapping>/bumperbot_controller/odom:=/odom</remapping>
        <remapping>/bumperbot_controller/transition_event:=/transition_event</remapping>
      </ros> -->
    </plugin>
  </gazebo>

</robot>