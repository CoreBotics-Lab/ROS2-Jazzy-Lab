<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="camera_length" value="0.024" />
    <xacro:property name="camera_width" value="0.09066445" />
    <xacro:property name="camera_height" value="0.02474825" />
    <xacro:property name="camera_mass" value="0.1" />
    <xacro:property name="camera_joint_x" value="0.056" />
    <xacro:property name="camera_joint_z" value="0.08299980" />
    <xacro:property name="optical_frame_to_camera_case_z" value="0.01241205" />
    
    <!-- Camera-->
    <link name="camera_link">
        <visual>
            <geometry>
                <mesh filename="package://bumperbot_description/meshes/RealSense_D435.gltf" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <origin xyz="${camera_length/2.0} 0 0" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="0.1" x="${camera_length}" y="${camera_width}" z="${camera_height}" o_xyz="${camera_length/2.0} 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="${camera_joint_x} 0 ${camera_joint_z}" rpy="0 0 0" />
    </joint>

    <!-- Camera Optical Frame-->
    <link name="camera_link_optical" />
    
    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="${camera_length/2.0} 0 ${optical_frame_to_camera_case_z}" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
    </joint>

    <!-- Camera Gazebo Plugin -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>0 0 ${optical_frame_to_camera_case_z} 0 0 0</pose>
            <topic>camera/image_raw</topic>
            <camera_info_topic>camera/camera_info</camera_info_topic>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <camera>
                <!-- Intel RealSense D435 RGB Specs: 69 deg H-FOV (1.20427 rad), 42 deg V-FOV -->
                <horizontal_fov>1.20427</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.105</near>
                    <far>10.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>
    
</robot>